{
  "name": "onejeys-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c cyan,green \"vite --host 0.0.0.0 --port 3000\" \"tsx watch server/dev.ts\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outdir=dist-server",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "framer-motion": "14.14.0",
    "lucide-react": "1.75.0",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
